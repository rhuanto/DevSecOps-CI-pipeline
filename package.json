{
  "name": "devsecops-ci-demo",
  "version": "1.0.0",
  "description": "App Node.js + Express para práctica DevSecOps CI en Azure App Service",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --coverage --forceExit",
