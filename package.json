    "audit:ci": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "lodash": "^4.17.4"
  },
  "devDependencies": {
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^3.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "supertest": "^6.3.4"
  },
  "keywords": [
    "devsecops",
    "azure",
    "ci",
    "express"
  ],
  "author": "Estudiante Ingeniería de Sistemas",
  "license": "MIT"
